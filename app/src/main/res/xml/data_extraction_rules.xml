<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Preserve non-secret SSH profile and app settings only; exclude herdr_mobile_local_prefs.xml. -->
    <cloud-backup>
        <include domain="sharedpref" path="herdr_mobile_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="herdr_mobile_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
